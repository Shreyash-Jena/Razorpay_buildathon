# ============================================================
# Agentic Commerce Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All Razorpay keys MUST be test-mode (rzp_test_...)
# ============================================================

# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM Provider (Groq) ---
# Get your key at: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# --- Agent Mandate IDs (set these after running the seed script) ---
# python scripts/seed_catalog.py  → copy the mandate_id values below
OPENAI_MANDATE_ID=
ANTHROPIC_MANDATE_ID=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./agentic_commerce.db

# --- Security ---
ADMIN_API_KEY=admin-secret-key-change-me

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
